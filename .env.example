# ── LLM 配置（OpenAI 兼容端点：DeepSeek / OpenAI / Anthropic 代理 / OpenRouter / 自部署 vLLM 等）──
# 把下面的值改成你自己的，并把文件改名为 .env

LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY="sk-换成你自己的 key"

# 可选：模型分档（不写则使用默认 DeepSeek 配置）
# MODEL_HIGH="deepseek-chat"
# MODEL_LOW="deepseek-chat"

# 可选：Planner 旗舰路径（chat 默认走 Planner-Executor，这里可关掉走固定流水线）
# ENABLE_PLANNER=1

# 可选：CORS 白名单（默认仅 127.0.0.1 / localhost；要从其它 host 访问时加这里）
# CORS_ORIGINS="http://192.168.1.100:8765,http://my-other-host:8765"

# 可选：服务端口（默认 8765）
# PORT=8765
